{
    // 保存时格式化
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    // 从不展示扩展缩写
    "emmet.showExpandedAbbreviation": "never",
    // 关闭代码区域小地图
    "editor.minimap.enabled": false,
    // 代码过长换行
    "editor.wordWrap": "on",
    "editor.indentSize": 2,
    "editor.tabSize": 2,
    "editor.detectIndentation": false
  }
  